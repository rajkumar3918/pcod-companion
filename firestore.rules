rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{accountId} {
      // accountId is the Firebase Auth uid tied to a signed-in Google account.
      // Signing in with the same Google account (any device) resolves to the
      // same uid, which is why access to an account requires that Google
      // account's credentials, not just knowing who owns it.
      allow read, write: if request.auth != null && request.auth.uid == accountId;

      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == accountId;

        match /logs/{date} {
          allow read, write: if request.auth != null && request.auth.uid == accountId;
        }
      }

      match /household/{doc} {
        // Shared pantry/shopping-list state — same account-level access as
        // everything else here, just not nested under any one profile.
        allow read, write: if request.auth != null && request.auth.uid == accountId;
      }
    }
  }
}
