rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{deviceId} {
      // deviceId is an anonymous Firebase Auth uid, not a real account —
      // still enforced server-side so a stranger with just the URL can't
      // read or write another device's profiles/data.
      allow read, write: if request.auth != null && request.auth.uid == deviceId;

      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == deviceId;

        match /logs/{date} {
          allow read, write: if request.auth != null && request.auth.uid == deviceId;
        }
      }
    }
  }
}
